// Committed — this is the Release/Archive config file, deliberately
// containing no secret. The paycheck scan (OpenAI, via PaycheckAIParser)
// needs a key; shipping it inside the binary is not safe (see
// Secrets.local.xcconfig, which does that for local Debug builds only).
// Every archived/TestFlight/App Store build resolves OPENAI_API_KEY to empty
// here, so PaycheckAIParser finds no key and reports itself not configured.
OPENAI_API_KEY =
